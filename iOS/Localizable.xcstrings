    "Are you sure you want to delete \"%@\"? All of its databases and users will be deleted immediately. You can't undo this action" : {
      "comment" : "A confirmation dialog that asks the user to confirm the deletion of a database instance. The argument is the name of the database instance.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du „%@“ wirklich löschen? Alle zugehörigen Datenbanken und Benutzer werden sofort gelöscht. Dies kann nicht rückgängig gemacht werden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que quieres eliminar \"%@\"? Todas sus bases de datos y usuarios se eliminarán inmediatamente; esta acción no se puede deshacer"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment supprimer « %@ » ? Toutes ses bases de données et tous ses utilisateurs seront supprimés immédiatement. Cette action est irréversible"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप वाकई \"%@\" को हटाना चाहते हैं? इसके सभी डेटाबेस और उपयोगकर्ता तुरंत हटा दिए जाएँगे; इस कार्रवाई को पूर्ववत नहीं किया जा सकता"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi davvero eliminare \"%@\"? Tutti i suoi database e utenti verranno eliminati immediatamente. Questa azione non può essere annullata"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je zeker dat je \"%@\" wilt verwijderen? Alle bijbehorende databases en gebruikers worden direct verwijderd. Dit kan niet ongedaan worden gemaakt"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить «%@»? Все её базы данных и пользователи будут удалены сразу. Это действие нельзя отменить"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" silinsin mi? Tüm veritabanları ve kullanıcıları hemen silinecek. Bu işlem geri alınamaz"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалити «%@»? Усі її бази даних і користувачі будуть видалені одразу. Цю дію неможливо скасувати"
          }
        }
      }
    },
