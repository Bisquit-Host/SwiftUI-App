  "targets": [
    {
      "name": "Bisquit-Host",
      "id": "F31BA5222958FF7C0006D126",
      "product": "id:F31BA5232958FF7C0006D126",
      "product-type": "application",
      "dependencies": [
        "Intent",
        "watchOS",
        "Widgets",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed ExtensionKit Extensions",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(EXTENSIONS_FOLDER_PATH)",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "package": "ANSI",
          "product-name": "ANSI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "AlertKit",
          "product-name": "AlertKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Appearance",
          "product-name": "Appearance",
          "build-phase": { "build-phase": "frameworks" },
        }, {
